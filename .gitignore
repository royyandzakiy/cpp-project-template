# =============================================================================
# clangd + CMake C++ template — focused ignore list
# =============================================================================

# ----- Build output -----
build/
# CLion default build dirs
cmake-build-*/
bin/
out/
Testing/

# CMake scratch (when configuring outside build/)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
*-prefix/
_deps/

# ----- clangd / compile database -----
# Mirrored to the project root by CMake; machine- and preset-specific.
compile_commands.json
# clangd background index
.cache/

# ----- Generated sources -----
# (mylib_export.h and version.h are generated into the build tree — see src/core/CMakeLists.txt)

# ----- Library install staging -----
# Auto-populated by MyLib's POST_BUILD `cmake --install` when INSTALL_LIB=ON (cmake/install.cmake).
generated_lib/

# ----- Package managers / local config -----
vcpkg_installed/
.vcpkg-cache/
CMakeUserPresets.json
project_options.local.cmake

# ----- Compiled artifacts -----
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app
*.pdb
*.ilk
*.exp
*.gch
*.pch

# ----- Coverage -----
*.gcda
*.gcno
*.profraw
*.profdata
coverage/

# ----- IDE / editor (kept project-agnostic) -----
# .vscode/ is committed (shared config); .idea/ is CLion-local.
.idea/
.vs/
*.user
.history/
*.code-workspace

# ----- Claude Code local settings -----
.claude/settings.local.json

# ----- OS junk -----
.DS_Store
Thumbs.db
desktop.ini

# ----- Editor swap/backup -----
*~
*.swp

.codebase-memory/
