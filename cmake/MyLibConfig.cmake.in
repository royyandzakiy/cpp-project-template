@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# A STATIC MyLib carries its PRIVATE deps into the consumer's link line, so they must be found
# here too. Declare them with find_dependency() (NOT find_package). A SHARED MyLib hides them.
if(NOT @BUILD_LIB_SHARED@)
  find_dependency(fmt CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/MyLibTargets.cmake")

check_required_components(MyLib)
